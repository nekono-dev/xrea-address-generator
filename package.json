{
  "name": "xrea-address-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XREAのメール転送アドレスをワンボタンで発行・管理するWebアプリ",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:spec": "prettier --check specs && node .claude/skills/spec-driven-development/scripts/check-all.mjs",
    "test:spec": "node .claude/skills/spec-driven-development/scripts/selftest.mjs",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:app && npm run build:gateway && npm run build:reader && npm run build:worker && npm run build:web",
    "build:app": "esbuild src/app/node.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/app/node.js",
    "build:gateway": "esbuild src/gateway/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/gateway/main.js",
    "build:reader": "esbuild src/reader/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/reader/main.js",
    "build:worker": "esbuild src/app/worker.ts --bundle --platform=browser --format=esm --conditions=workerd,worker,browser --minify --outfile=dist/worker/index.js",
    "build:web": "vite build",
    "deploy:cloud": "tsx scripts/cloud/deploy.ts",
    "destroy:cloud": "tsx scripts/cloud/destroy.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsx scripts/xrea-docs/fetch.ts check",
    "docs:snapshot": "tsx scripts/xrea-docs/fetch.ts snapshot",
    "docs:generate": "tsx scripts/xrea-docs/generate.ts",
    "docs:types": "openapi-typescript api/xrea.openapi.yaml --default-non-nullable false -o src/xrea/generated/schema.d.ts",
    "docs:all": "npm run docs:generate && npm run docs:types"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "miniflare": "^4.20260730.0",
    "node-html-parser": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "preact": "^11.0.1"
  }
}
