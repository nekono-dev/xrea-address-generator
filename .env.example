# 認証情報を暗号化する鍵の元になる秘密値（32文字以上、必須）。例: openssl rand -base64 48
COOKIE_SECRET=
# アプリと読み取りサービスの共有シークレット（32文字以上。PROTON_READER_URL を設定するときだけ必須）。例: openssl rand -base64 48
INTERNAL_TOKEN=
# 認証情報の保持方式。cookie（既定）または sqlite（cookieにはセッションIDだけを入れる）
CREDENTIAL_STORE=
# proton を指定すると、Proton Pass読み取りサービスを起動する
COMPOSE_PROFILES=
# Proton Pass読み取りサービスのURL。proton を選ぶときは http://proton-reader:8082。空ならProton Pass連携を使わない（httpを使えるのは、proton-reader、localhost、プライベートIPアドレスのみ）
PROTON_READER_URL=
# Cloudflare Tunnelのトークン。空ならトンネルを使わず、LANに公開する（compose.lan.yaml を重ねる）
TUNNEL_TOKEN=
# ログの詳細度（既定は info）
LOG_LEVEL=
# サーバ名の一覧の設定ファイル（既定は ./config/xrea-servers.json）。書き換えてアプリを再起動すると反映される
XREA_SERVERS_CONFIG=
# LAN用の追加定義（compose.lan.yaml）で公開するホスト側のポート（既定は 3000）
APP_PORT=
