# XREAのアカウントID
XREA_ACCOUNT=
# XREAのサーバ名（例: s1001.xrea.com）
XREA_SERVER_NAME=
# XREAのAPIシークレットキー
XREA_API_SECRET_KEY=
# Proton Passの読み取り専用アクセストークン（pst_...::...）。空ならProton Pass連携を使わない
PROTON_PASS_PERSONAL_ACCESS_TOKEN=
# Cloudflare Tunnelのトークン。空ならトンネルを使わず、LANに公開する
TUNNEL_TOKEN=
# ログの詳細度
LOG_LEVEL=info
